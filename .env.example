# ===================================================================
# Ultimate TeraBox Downloader Bot - Environment Configuration
# ===================================================================

# Telegram Bot Configuration
# Obtain your Bot Token from @BotFather on Telegram
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Comma-separated list of Telegram User IDs who have administrative privileges
ADMIN_IDS=123456789,987654321

# Database Configuration
# Default is async SQLite. For production PostgreSQL, use:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/terabox_db
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Optional Redis Cache / Queue
# REDIS_URL=redis://localhost:6379/0

# Storage Directories
DOWNLOAD_DIR=./storage/downloads
TEMP_DIR=./storage/temp
ARCHIVE_DIR=./storage/archives

# Limits & Concurrency
# Maximum file size permitted for download (in megabytes)
MAX_FILE_SIZE_MB=2000

# Telegram Upload Limit (in megabytes):
# Standard Telegram Bot API limit is 50MB.
# If running a local Telegram Bot API Server, set up to 2000MB.
MAX_TG_UPLOAD_SIZE_MB=50

# Optional URL of your self-hosted Telegram Bot API Server
# LOCAL_BOT_API_SERVER_URL=http://localhost:8081

# Worker Concurrency Settings
MAX_CONCURRENT_DOWNLOADS=10
MAX_USER_ACTIVE_JOBS=0
MAX_QUEUE_SIZE=1000
DOWNLOAD_RETRIES=3

# Private Temporary Download Link Server
TEMP_SERVER_HOST=0.0.0.0
TEMP_SERVER_PORT=8080
# Public base URL used to construct download links sent to users
TEMP_SERVER_BASE_URL=http://localhost:8080
TEMP_LINK_EXPIRY_HOURS=6
AUTO_DELETE_TEMP_FILES=true
CLEANUP_INTERVAL_MINUTES=15
MIN_FREE_DISK_SPACE_MB=500

# TeraBox Session Authentication
# Paste your TeraBox 'ndus' cookie value here (from browser dev tools)
TERABOX_COOKIE=

# Optional Custom Resolver API (e.g. self-hosted terabox-gateway)
# TERABOX_API_URL=http://localhost:5000/api/resolve

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
